---
// Edge-to-edge gallery in justified rows. Each photo opens a keyboard-friendly lightbox.
import { Image, getImage } from "astro:assets";
import type { Photo } from "../data/site";
import { photo } from "../lib/photos";

interface Props {
  photos: Photo[];
  label: string;
}
const { photos, label } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const src = photo(p.file);
    const large = await getImage({ src, width: Math.min(src.width, 2000), format: "webp", quality: 82 });
    return { ...p, src, large: large.src, ratio: src.width / src.height };
  }),
);
---

<ul class="gallery" data-gallery aria-label={label}>
  {
    items.map((item, i) => (
      <li style={`--r: ${item.ratio.toFixed(3)}`}>
        <a
          href={item.large}
          class="tile"
          data-index={i}
          data-full={item.large}
          data-alt={item.alt}
          data-caption={item.caption ?? ""}
          data-w={item.src.width}
          data-h={item.src.height}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[480, 800, 1200, 1600]}
            sizes={`(max-width: 640px) 100vw, ${Math.round(Math.min(item.ratio, 2) * 40)}vw`}
            loading={i < 2 ? "eager" : "lazy"}
            format="webp"
          />
          {item.caption && <span class="cap">{item.caption}</span>}
        </a>
      </li>
    ))
  }
  <li class="filler" aria-hidden="true"></li>
</ul>

<dialog class="lightbox" aria-label="Photo viewer">
  <div class="lb-frame">
    <figure class="lb-figure">
      <img class="lb-img" alt="" />
      <figcaption class="lb-caption">
        <span class="lb-text"></span>
        <span class="lb-count" aria-live="polite"></span>
      </figcaption>
    </figure>
    <button class="lb-btn lb-close" type="button" aria-label="Close photo viewer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
    </button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
    </button>
  </div>
</dialog>

<script>
  type Item = { full: string; alt: string; caption: string; w: number; h: number; trigger: HTMLAnchorElement };

  const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox");
  const grid = document.querySelector<HTMLElement>("[data-gallery]");

  if (dialog && grid) {
    const tiles = [...grid.querySelectorAll<HTMLAnchorElement>("a.tile")];
    const items: Item[] = tiles.map((a) => ({
      full: a.dataset.full!,
      alt: a.dataset.alt!,
      caption: a.dataset.caption!,
      w: Number(a.dataset.w),
      h: Number(a.dataset.h),
      trigger: a,
    }));
    const img = dialog.querySelector<HTMLImageElement>(".lb-img")!;
    const text = dialog.querySelector<HTMLElement>(".lb-text")!;
    const count = dialog.querySelector<HTMLElement>(".lb-count")!;
    let index = 0;
    let returnTo: HTMLElement | null = null;

    const preload = (i: number) => {
      const it = items[(i + items.length) % items.length];
      const pre = new Image();
      pre.src = it.full;
    };

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      img.src = it.full;
      img.alt = it.alt;
      img.width = it.w;
      img.height = it.h;
      text.textContent = it.caption || it.alt;
      count.textContent = `${index + 1} of ${items.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number) => {
      returnTo = items[i].trigger;
      show(i);
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>(".lb-close")!.focus();
      document.documentElement.style.overflow = "hidden";
    };

    tiles.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        open(i);
      }),
    );

    dialog.querySelector(".lb-close")!.addEventListener("click", () => dialog.close());
    dialog.querySelector(".lb-prev")!.addEventListener("click", () => show(index - 1));
    dialog.querySelector(".lb-next")!.addEventListener("click", () => show(index + 1));

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      returnTo?.focus();
    });

    // Click on the dark backdrop (not the photo or buttons) closes.
    dialog.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains("lb-frame")) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === "Home") {
        e.preventDefault();
        show(0);
      } else if (e.key === "End") {
        e.preventDefault();
        show(items.length - 1);
      } else if (e.key === "Tab") {
        // Keep focus on the three buttons while the viewer is open.
        const buttons = [...dialog.querySelectorAll<HTMLButtonElement>("button")];
        const pos = buttons.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        const next = e.shiftKey ? pos - 1 : pos + 1;
        buttons[(next + buttons.length) % buttons.length].focus();
      }
    });

    // Swipe left or right on touch screens.
    let startX = 0;
    dialog.addEventListener("pointerdown", (e) => (startX = e.clientX));
    dialog.addEventListener("pointerup", (e) => {
      const dx = e.clientX - startX;
      if (e.pointerType !== "mouse" && Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0 var(--gap);
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }
  .gallery li {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * clamp(220px, 30vw, 420px));
    min-width: 0;
  }
  .gallery li.filler {
    flex-grow: 400;
    flex-basis: 0;
    height: 0;
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: var(--r);
    overflow: hidden;
    background: var(--line);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s var(--ease);
  }
  .tile:hover img {
    opacity: 0.92;
  }
  .tile:focus-visible {
    outline-offset: -4px;
    outline: 3px solid #fff;
    box-shadow: inset 0 0 0 5px #000;
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1rem 0.8rem;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }
  .tile:hover .cap,
  .tile:focus-visible .cap {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .gallery li {
      flex-basis: 100%;
    }
    .cap {
      opacity: 1;
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 8 8 / 0.96);
    color: #f2f1ee;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .lightbox[open] {
    animation: fade 0.25s ease;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lb-frame {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 64px clamp(16px, 7vw, 96px) 24px;
  }
  .lb-figure {
    margin: 0;
    display: grid;
    gap: 0.9rem;
    max-width: 100%;
    max-height: 100%;
    justify-items: center;
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100dvh - 160px);
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
  }
  .lb-caption {
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    width: 100%;
    font-size: 0.9rem;
    color: #cfcdc8;
  }
  .lb-count {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lb-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.2);
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
  }
  .lb-btn:hover {
    background: rgb(255 255 255 / 0.18);
  }
  .lb-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .lb-btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .lb-close {
    top: 12px;
    right: 12px;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 12px;
  }
  .lb-next {
    right: 12px;
  }
  @media (max-width: 640px) {
    .lb-frame {
      padding: 64px 12px 88px;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 20px;
      transform: none;
    }
    .lb-prev {
      left: calc(50% - 60px);
    }
    .lb-next {
      right: calc(50% - 60px);
    }
  }
</style>
