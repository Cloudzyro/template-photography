---
// Sends to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a Supabase function or similar).
// With no endpoint set, the form opens the visitor's email app instead.
import { site, booking } from "../data/site";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const subject = `Booking inquiry for ${site.name}`;
---

<form
  class="booking"
  method="post"
  action={endpoint || `mailto:${site.email}`}
  data-endpoint={endpoint}
  data-email={site.email}
  data-subject={subject}
>
  {
    !endpoint && (
      <p class="note" role="note">
        This form isn't connected yet, so sending it opens your email app. You can also write to{" "}
        <a href={`mailto:${site.email}?subject=${encodeURIComponent(subject)}`}>{site.email}</a>.
      </p>
    )
  }
  <input type="hidden" name="_subject" value={subject} />
  <div class="row">
    <label>
      <span>Name</span>
      <input name="name" autocomplete="name" required />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>
  <div class="row">
    <label>
      <span>Type of session</span>
      <select name="session_type" id="session-type">
        {booking.sessionTypes.map((t) => <option>{t}</option>)}
      </select>
    </label>
    <label>
      <span>Preferred date <small>(optional)</small></span>
      <input name="date" type="date" />
    </label>
  </div>
  <div class="row">
    <label>
      <span>Location <small>(optional)</small></span>
      <input name="location" autocomplete="address-level2" />
    </label>
    <label>
      <span>Budget <small>(optional)</small></span>
      <select name="budget">
        <option value="">Choose one</option>
        <option>Under $500</option>
        <option>$500 to $1,500</option>
        <option>$1,500 to $3,000</option>
        <option>Over $3,000</option>
      </select>
    </label>
  </div>
  <label>
    <span>Tell me about your project</span>
    <textarea name="message" rows="6" required></textarea>
  </label>
  <button class="btn btn-solid" type="submit">Send inquiry</button>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  // Preselect the session type when arriving from a service's Inquire button.
  const type = new URLSearchParams(location.search).get("type");
  const select = document.getElementById("session-type") as HTMLSelectElement | null;
  if (type && select && [...select.options].some((o) => o.value === type)) select.value = type;

  document.querySelectorAll<HTMLFormElement>("form.booking").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".status")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { endpoint, email, subject } = form.dataset;
      const data = new FormData(form);

      if (!endpoint) {
        const lines = [...data.entries()]
          .filter(([key]) => !key.startsWith("_"))
          .map(([key, value]) => `${key.replace(/_/g, " ")}: ${value}`);
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
        status.textContent = "Your email app should open with your details filled in.";
        return;
      }

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "Sending...";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "Thank you. Your inquiry is on its way, and I'll reply within two working days.";
      } catch {
        status.innerHTML = "";
        status.append("Sorry, that didn't send. Please email ");
        const link = Object.assign(document.createElement("a"), { href: `mailto:${email}`, textContent: email });
        status.append(link, " instead.");
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .booking {
    display: grid;
    gap: 1.5rem;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
  }
  small {
    font-weight: 400;
    font-size: 0.875rem;
  }
  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--muted);
    border-radius: 0;
    padding: 0.6rem 0;
    min-height: 48px;
  }
  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 12px) 55%,
      calc(100% - 7px) 55%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }
  select option {
    background: var(--bg);
    color: var(--ink);
  }
  textarea {
    border: 1px solid var(--muted);
    padding: 0.75rem;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .note {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 2px solid var(--ink);
    background: var(--bg-raised);
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .status {
    margin: 0;
    min-height: 1.5em;
    font-weight: 500;
  }
  button {
    justify-self: start;
  }
</style>
