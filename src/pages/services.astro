---
import Base from "../layouts/Base.astro";
import { services, site } from "../data/site";
---

<Base title="Services and pricing" description={`Portrait, editorial and interiors photography by ${site.name}, with clear starting prices.`}>
  <section class="section">
    <div class="wrap">
      <span class="label">Commissions</span>
      <h1>Services and pricing</h1>
      <p class="lede">Clear starting prices for the work I do most. Every project is a little different, so I'll send a written quote before anything is booked.</p>
      <ul class="plans">
        {
          services.map((s) => (
            <li class:list={["plan", { featured: s.featured }]}>
              {s.featured && <span class="tag">Most booked</span>}
              <h2>{s.name}</h2>
              <p class="desc">{s.description}</p>
              <p class="price">
                <span class="amount">{s.price}</span> <span class="unit">{s.unit}</span>
              </p>
              <ul class="incl">
                {s.includes.map((x) => <li>{x}</li>)}
              </ul>
              <a class:list={["btn", { "btn-solid": s.featured }]} href={`/book/?type=${encodeURIComponent(s.name)}`}>
                Inquire
              </a>
            </li>
          ))
        }
      </ul>
      <div class="faq">
        <h2>Good to know</h2>
        <dl>
          <div>
            <dt>How far ahead should I book?</dt>
            <dd>Portraits usually two to four weeks ahead. Editorial and brand days are often planned a month or more in advance.</dd>
          </div>
          <div>
            <dt>Do you travel?</dt>
            <dd>Yes. Travel within 50 miles is included. Beyond that I add travel at cost, agreed before booking.</dd>
          </div>
          <div>
            <dt>When will I get my photographs?</dt>
            <dd>Within two weeks for portraits and three weeks for commercial work, in a private online gallery.</dd>
          </div>
          <div>
            <dt>Is there a deposit?</dt>
            <dd>A 30% deposit holds your date. The rest is due on delivery.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .plans {
    list-style: none;
    margin: clamp(40px, 6vw, 72px) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    border-top: 1px solid var(--ink);
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem clamp(16px, 2.5vw, 32px) 2.25rem;
    border-bottom: 1px solid var(--line);
  }
  .plan + .plan {
    border-left: 1px solid var(--line);
  }
  .featured {
    background: var(--bg-raised);
  }
  .tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .plan h2 {
    font-size: 2rem;
    margin-top: 1.25rem;
  }
  .desc {
    color: var(--muted);
  }
  .amount {
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 1;
  }
  .unit {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .incl {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    flex: 1;
  }
  .incl li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .plan .btn {
    align-self: start;
  }
  .faq {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
  }
  .faq dl {
    margin: 0;
  }
  .faq div {
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .faq dt {
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .faq dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .plan + .plan {
      border-left: 0;
    }
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
