---
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery.astro";
import { collections } from "../../data/site";
import { photo } from "../../lib/photos";

export function getStaticPaths() {
  return collections.map((c, i) => ({
    params: { slug: c.slug },
    props: { collection: c, next: collections[(i + 1) % collections.length] },
  }));
}

const { collection: c, next } = Astro.props;
const share = await getImage({ src: photo(c.cover), width: 1200, height: 630, fit: "cover", format: "jpg" });
---

<Base title={c.title} description={c.summary} image={share.src}>
  <header class="wrap intro">
    <a class="back" href="/work/">All work</a>
    <h1>{c.title}</h1>
    <div class="meta">
      <p class="lede">{c.summary}</p>
      <dl>
        <div><dt>Year</dt><dd>{c.year}</dd></div>
        <div><dt>Photographs</dt><dd>{c.photos.length}</dd></div>
      </dl>
    </div>
  </header>

  <Gallery photos={c.photos} label={`${c.title} photographs`} />

  <nav class="wrap next" aria-label="Next collection">
    <span class="label">Next collection</span>
    <a href={`/work/${next.slug}/`}>{next.title}</a>
  </nav>
</Base>

<style>
  .intro {
    padding-block: clamp(40px, 7vw, 96px) clamp(32px, 5vw, 56px);
  }
  .back {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin-top: 1.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
  }
  .meta .lede {
    margin: 0;
  }
  dl {
    display: flex;
    gap: 2.5rem;
    margin: 0;
  }
  dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
  }
  .next {
    padding-block: clamp(64px, 10vw, 128px);
    text-align: center;
  }
  .next a {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 6rem);
    text-decoration: none;
    line-height: 1;
  }
  .next a:hover {
    font-style: italic;
  }
</style>
