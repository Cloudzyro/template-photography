---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { about, site } from "../data/site";
import { photo } from "../lib/photos";
---

<Base title="About" description={`About ${site.name}, ${site.role.toLowerCase()}. ${site.location}.`}>
  <section class="section">
    <div class="wrap grid">
      <div class="portrait">
        <Image src={photo(about.portrait)} alt={about.portraitAlt} widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 40vw" format="webp" loading="eager" />
      </div>
      <div class="text">
        <span class="label">About</span>
        <h1>Hello, I'm <em>{site.name.split(" ")[0]}</em>.</h1>
        {about.paragraphs.map((p, i) => <p class={i === 0 ? "lede" : undefined}>{p}</p>)}
        <h2 class="clients-title">Selected clients</h2>
        <ul class="clients">
          {about.clients.map((c) => <li>{c}</li>)}
        </ul>
        <a class="btn btn-solid" href="/book/">Work with me</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .portrait {
    position: sticky;
    top: 96px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--line);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
  }
  .text p:not(.lede) {
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .clients-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 3rem;
  }
  .clients {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    border-top: 1px solid var(--line);
  }
  .clients li {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: static;
      aspect-ratio: 3 / 2;
    }
  }
</style>
