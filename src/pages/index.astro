---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CollectionCard from "../components/CollectionCard.astro";
import { site, home, collections, services } from "../data/site";
import { photo } from "../lib/photos";

const hero = photo(home.heroPhoto);
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero-img"
      src={hero}
      alt={home.heroAlt}
      widths={[640, 1024, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={88}
    />
    <div class="hero-copy">
      <h1 id="hero-title">{site.name}</h1>
      <p>{site.role}. {site.location}.</p>
    </div>
  </section>

  <section class="section intro">
    <div class="wrap intro-grid">
      <span class="label">Introduction</span>
      <div>
        <p class="statement">{home.intro}</p>
        <p class="lede">{home.text}</p>
        <a class="btn" href="/about/">About me</a>
      </div>
    </div>
  </section>

  <section class="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="head">
        <h2 id="work-title">Selected work</h2>
        <a href="/work/">All collections</a>
      </div>
      <ul class="cards">
        {
          collections.map((c, i) => (
            <li>
              <CollectionCard collection={c} index={i} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section services">
    <div class="wrap">
      <div class="head">
        <h2>Commissions</h2>
        <a href="/services/">Services and pricing</a>
      </div>
      <ul class="svc">
        {
          services.map((s) => (
            <li>
              <h3>{s.name}</h3>
              <p>{s.description}</p>
              <span class="price">
                From {s.price} {s.unit}
              </span>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-solid" href="/book/">Book a session</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    height: min(88vh, 900px);
    min-height: 460px;
    overflow: hidden;
    background: #222;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.35));
  }
  .hero-copy {
    z-index: 1;
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(24px, 5vw, 56px);
    color: #fff;
    text-shadow: 0 1px 30px rgb(0 0 0 / 0.25);
  }
  .hero-copy h1 {
    margin: 0;
    line-height: 0.92;
  }
  .hero-copy p {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 2rem;
  }
  .statement {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    margin-bottom: 1.5rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1rem;
  }
  .head h2 {
    margin: 0;
  }
  .head a {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px) clamp(16px, 3vw, 32px);
  }
  .cards li:nth-child(even) {
    margin-top: clamp(0px, 8vw, 120px);
  }
  .svc {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }
  .svc p {
    color: var(--muted);
  }
  .price {
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .intro-grid,
    .cards {
      grid-template-columns: 1fr;
    }
    .cards li:nth-child(even) {
      margin-top: 0;
    }
    .hero {
      height: 72vh;
    }
  }
</style>
